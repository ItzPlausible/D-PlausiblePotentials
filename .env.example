# Copy to .env and fill only what your current project needs.
# Never use production private keys in local examples.

# RPC endpoints
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
POLYGON_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=

# Testnet-only deployer key. Use a throwaway key.
TESTNET_PRIVATE_KEY=

# Block explorer verification
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISTIC_ETHERSCAN_API_KEY=

# WalletConnect / app integrations
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# AI tooling
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
